{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Omit<PlayerConfig,\"owner\"|\"num\">": {
            "properties": {
                "match": {
                    "properties": {
                        "champion": {
                            "type": "string"
                        },
                        "skin": {
                            "type": "number"
                        },
                        "team": {
                            "$ref": "#/definitions/TeamId"
                        }
                    },
                    "type": "object"
                },
                "runes": {
                    "items": {
                        "type": "number"
                    },
                    "type": "array"
                },
                "summoner": {
                    "properties": {
                        "iconId": {
                            "type": "number"
                        },
                        "id": {
                            "type": "number"
                        },
                        "level": {
                            "type": "number"
                        },
                        "name": {
                            "type": "string"
                        },
                        "rankId": {
                            "type": "number"
                        },
                        "ribbonId": {
                            "type": "number"
                        },
                        "spells": {
                            "properties": {
                                "d": {
                                    "type": "string"
                                },
                                "f": {
                                    "type": "string"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "type": "object"
                },
                "talents": {
                    "items": {
                        "type": "number"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "Partial<DebuggingConfig>": {
            "properties": {
                "chatDebugMessages": {
                    "type": "boolean"
                },
                "enabled": {
                    "type": "boolean"
                },
                "noGrassCheck": {
                    "type": "boolean"
                },
                "noNavmeshVision": {
                    "type": "boolean"
                },
                "noPathFinding": {
                    "type": "boolean"
                },
                "noSpawners": {
                    "type": "boolean"
                },
                "noTerrainEscape": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "Partial<LoggingConfig>": {
            "properties": {
                "debug": {
                    "enum": [
                        "console",
                        "file",
                        "none",
                        "websocket"
                    ],
                    "type": "string"
                },
                "packet": {
                    "enum": [
                        "console",
                        "file",
                        "none",
                        "websocket"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "Partial<TestingConfig>": {
            "properties": {
                "adminCommands": {
                    "type": "boolean"
                },
                "bringHeroesToLine": {
                    "type": "boolean"
                },
                "enabled": {
                    "type": "boolean"
                },
                "levelUpPlayers": {
                    "type": "number"
                },
                "noAutoGameStart": {
                    "type": "boolean"
                },
                "noCooldowns": {
                    "type": "boolean"
                },
                "noHeroDying": {
                    "type": "boolean"
                },
                "noManaCosts": {
                    "type": "boolean"
                },
                "noSpellRangeCheck": {
                    "type": "boolean"
                },
                "spawnMinionsLine": {
                    "type": "number"
                },
                "startingGold": {
                    "type": "number"
                },
                "wavesInitialTimeToSpawn": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "TeamId": {
            "enum": [
                -100,
                0,
                100,
                200,
                300
            ],
            "type": "number"
        }
    },
    "properties": {
        "debugging": {
            "$ref": "#/definitions/Partial%3CDebuggingConfig%3E"
        },
        "game": {
            "properties": {
                "id": {
                    "type": "number"
                },
                "map": {
                    "type": "number"
                },
                "version": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "logging": {
            "$ref": "#/definitions/Partial%3CLoggingConfig%3E"
        },
        "players": {
            "items": {
                "$ref": "#/definitions/Omit%3CPlayerConfig%2C%22owner%22%7C%22num%22%3E"
            },
            "type": "array"
        },
        "server": {},
        "testing": {
            "$ref": "#/definitions/Partial%3CTestingConfig%3E"
        }
    },
    "type": "object"
}


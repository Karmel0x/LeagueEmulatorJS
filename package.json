{
    "name": "leagueemulatorjs",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^25",
        "eslint": "^9.39.2",
        "globals": "^17.0.0",
        "typescript-eslint": "^8.51.0"
    },
    "scripts": {
        "dev": "cd apps && cd gameserver && tsx src/main",
        "pi": "cd apps && cd tools && tsx packet-inspector",
